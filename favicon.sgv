<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
<defs>
<linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#2a1a3a;stop-opacity:1"/>
<stop offset="100%" style="stop-color:#0a0510;stop-opacity:1"/>
</linearGradient>
<linearGradient id="stoneGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#8a7a9a;stop-opacity:1"/>
<stop offset="50%" style="stop-color:#5a4a6a;stop-opacity:1"/>
<stop offset="100%" style="stop-color:#3a2a4a;stop-opacity:1"/>
</linearGradient>
<linearGradient id="crossGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#e0d0f0;stop-opacity:1"/>
<stop offset="100%" style="stop-color:#a090b0;stop-opacity:1"/>
</linearGradient>
<filter id="glow">
<feGaussianBlur stdDeviation="0.8" result="blur"/>
<feMerge>
<feMergeNode in="blur"/>
<feMergeNode in="SourceGraphic"/>
</feMerge>
</filter>
</defs>
<rect width="64" height="64" rx="14" fill="url(#bgGrad)"/>
<circle cx="48" cy="16" r="8" fill="#e0d0f0" opacity="0.15"/>
<ellipse cx="32" cy="56" rx="26" ry="3" fill="#1a0a1a" opacity="0.8"/>
<path d="M 20 54 L 20 28 Q 20 16 32 16 Q 44 16 44 28 L 44 54 Z" fill="url(#stoneGrad)" stroke="#3a2a4a" stroke-width="0.5"/>
<path d="M 22 52 L 22 28 Q 22 18 32 18 Q 42 18 42 28 L 42 52" fill="none" stroke="#7a6a8a" stroke-width="0.4" opacity="0.6"/>
<g filter="url(#glow)">
<rect x="30.5" y="26" width="3" height="18" rx="0.5" fill="url(#crossGrad)"/>
<rect x="26" y="30.5" width="12" height="3" rx="0.5" fill="url(#crossGrad)"/>
</g>
<text x="32" y="50" font-family="Georgia, serif" font-size="4" font-weight="bold" text-anchor="middle" fill="#8a7a9a" opacity="0.7">OCD</text>
<circle cx="12" cy="52" r="1" fill="#ff6eb4" opacity="0.6"/>
<circle cx="52" cy="52" r="1" fill="#7c6aff" opacity="0.6"/>
</svg>